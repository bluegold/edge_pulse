{
  "name": "edge-pulse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "scheduled:fire": "node scripts/scheduled-fire.mjs",
    "pulse": "node scripts/pulse.mjs",
    "db:migrate:local": "wrangler d1 migrations apply pulse-db --local",
    "deploy": "wrangler deploy",
    "types": "wrangler types ./src/env.d.ts",
    "check": "wrangler check startup --args=--containers-rollout=none",
    "verify": "npm run lint && npm run test && npm run typecheck && npm run check",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.101.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "d3": "^7.9.0",
    "hono": "^4.12.26",
    "ipaddr.js": "^2.4.0"
  }
}
